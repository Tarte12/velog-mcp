{
  "name": "@tartelettie_/velog-mcp",
  "version": "0.1.0",
  "private": false,
  "description": "A local MCP server for safely reading, indexing, exporting, and publishing Velog posts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarte12/velog-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Tarte12/velog-mcp/issues"
  },
  "homepage": "https://github.com/Tarte12/velog-mcp#readme",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "velog-auth": "pnpm run build && node dist/src/auth-cli.js",
    "smoke:velog": "pnpm run build && node dist/src/smoke-cli.js",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test --test-isolation=none dist/test/velog-gateway.test.js dist/test/markdown.test.js dist/test/write-tools.test.js dist/test/credentials.test.js dist/test/local-index.test.js"
  },
  "bin": {
    "velog-mcp": "dist/src/index.js",
    "velog-auth": "dist/src/auth-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
